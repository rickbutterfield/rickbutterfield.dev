{
  "name": "rickbutterfield",
  "compatibility_date": "2025-05-30",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every page is prerendered, so only server islands need the Worker. Unknown URLs get the
    // static 404 page (Astro's Worker throws on prerendered dynamic routes like /[slug] instead)
    "run_worker_first": ["/_server-islands/*"],
    "not_found_handling": "404-page"
  },
  // Activity cards on /now. Secrets (Strava, Spotify, X, optional GITHUB_TOKEN) are set with
  // `wrangler secret put`, or in .dev.vars locally; any source without them is skipped.
  "vars": {
    "GITHUB_USERNAME": "rickbutterfield"
  },
  // Worker logs, so failing server islands (the /now activity cards) show up in the dashboard
  "observability": {
    "enabled": true
  }
}
