---
import ContentPage from "@/components/views/ContentPage.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const contentPagesCollection = await getCollection("contentPages");

  return contentPagesCollection.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { page: entry.data.content },
  }));
}

const { page } = Astro.props;
---

<ContentPage page={page} />
