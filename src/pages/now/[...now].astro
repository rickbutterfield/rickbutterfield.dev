---
import { marked } from "marked";
import Layout from "@/layouts/Layout.astro";
import UmbracoGrid from "@/components/UmbracoGrid.astro";
import Activity from "@/components/Activity.astro";
import { getCollection } from "astro:content";
import type { EventInfoElementModel, NowPageContentModel } from "@/api";

// Only build /now when Umbraco has a published Now page, so unpublishing it can't break the build
export async function getStaticPaths() {
  const [nowPage] = await getCollection("nowPage");
  return nowPage ? [{ params: { now: undefined }, props: { node: nowPage.data.content } }] : [];
}

const { node } = Astro.props as { node: NowPageContentModel };

const { title, content, grid, location, upcoming: manualEntries } = node.properties ?? {};
// Umbraco's own last-saved date, so it moves whenever the page is edited
const updated = new Date(node.updateDate);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-gb", { year: "numeric", month: "short", day: "numeric" });

// Coming up: every speaking date (main event plus additional events) and every manual entry
// from the Now page that hasn't happened at build time, in one date-sorted list. The script
// below also hides any that pass before the next rebuild.
interface UpcomingEntry {
  name: string;
  date: Date;
  url?: string | null;
  /** Talk title for speaking dates; manual entries have none */
  talk?: string;
}

const buildDay = new Date();
buildDay.setUTCHours(0, 0, 0, 0);

const toEntry = (event: EventInfoElementModel["properties"], talk?: string): UpcomingEntry[] =>
  event?.eventName && event.eventDate && new Date(event.eventDate) >= buildDay
    ? [{ name: event.eventName, date: new Date(event.eventDate), url: event.eventUrl, talk }]
    : [];

const talkEntries = (await getCollection("speaking")).flatMap(({ data }) => {
  const talk = data.content.properties;
  const title = talk?.title ?? data.name;
  return [
    ...toEntry(talk, title),
    ...(talk?.additionalEvents?.items ?? []).flatMap((item) =>
      toEntry((item.content as EventInfoElementModel).properties, title)),
  ];
});

const customEntries = (manualEntries?.items ?? []).flatMap((item) =>
  toEntry((item.content as EventInfoElementModel).properties));

const upcoming = [...talkEntries, ...customEntries].sort((a, b) => a.date.getTime() - b.date.getTime());
---

<Layout name={title ?? node.name}>
  <article class="c-article c-flow">
    <p class="c-article__dateline">
      <time datetime={updated.toISOString()}>Updated {formatDate(updated)}</time><span data-age-of={updated.toISOString()} hidden></span>{location && <span> · {location}</span>}
    </p>
    <h1>{title ?? node.name}</h1>
    {content && (
      <Fragment set:html={marked.parse(content)} />
    )}

    <UmbracoGrid data={grid} />

    {upcoming.length > 0 && (
      <section class="c-flow c-article__upcoming" data-upcoming>
        <h2>🗓️ Coming up</h2>
        <ul>
          {upcoming.map((event) => (
            <li data-event-date={event.date.toISOString()}>
              <time datetime={event.date.toISOString()}>{formatDate(event.date)}</time>:{" "}
              {event.talk && "speaking at "}{event.url ? <a href={event.url}>{event.name}</a> : event.name}
              {event.talk && <> about <a href="/speaking">{event.talk}</a></>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <Activity server:defer>
      <section slot="fallback" class="c-activity c-activity--loading" aria-hidden="true">
        <h2>Activity</h2>
        <div class="c-activity__grid">
          <div class="c-activity__card"></div>
          <div class="c-activity__card"></div>
        </div>
      </section>
    </Activity>

    <p class="c-article__note">
      This is a <a href="https://nownownow.com/about">now page</a>. If you have your own site, you should make one too.
    </p>
  </article>
</Layout>

<script>
  // The page is only rebuilt on publish, so anything relative to "today" is worked out here
  const DAY = 86_400_000;
  const relative = new Intl.RelativeTimeFormat("en-gb", { numeric: "auto" });

  // Calendar days in the visitor's timezone, so "yesterday" means the previous date rather than 24+ hours ago
  const startOfDay = (date: Date) => new Date(date.getFullYear(), date.getMonth(), date.getDate()).getTime();

  function age(iso: string): string {
    // Rounded because a DST change makes a calendar day 23 or 25 hours long
    const days = Math.round((startOfDay(new Date()) - startOfDay(new Date(iso))) / DAY);
    if (days < 31) return relative.format(-days, "day");
    if (days < 365) return relative.format(-Math.floor(days / 30), "month");
    return relative.format(-Math.floor(days / 365), "year");
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-age-of]").forEach((el) => {
      el.textContent = ` · ${age(el.dataset.ageOf!)}`;
      el.hidden = false;
    });

    // Drop events that have passed since the last build, and the section if none are left
    document.querySelectorAll<HTMLElement>("[data-event-date]").forEach((el) => {
      if (Date.parse(el.dataset.eventDate!) + DAY <= Date.now()) el.remove();
    });
    document.querySelectorAll<HTMLElement>("[data-upcoming]").forEach((section) => {
      if (!section.querySelector("[data-event-date]")) section.remove();
    });
  });
</script>
